# RStudio
.Rproj.user
.Rhistory
.RData
.Ruserdata

# Data — all gitignored (see data/README.md for sources)
data/package/
data/external/
data/interim/
data/final/

# Outputs — all generated by scripts
outputs/


# Local only: superseded code (archive/) and working notes (docs/); kept in git history
archive/
docs/

# Large/binary files
*.csv
*.xlsx
*.h5
*.rds

# Generated plots and images
*.png
*.jpg
*.pdf
*.tiff

# Documents
*.docx

# macOS
.DS_Store

# NEON downloaded data
NEON_eddy-flux/
filesToStack*/
HARV_NEON_clean_30min/

# Claude worktrees
.claude/

# Git backup
.git-backup/

# Manuscript drafts (local)
DRAFT_*

# Allow READMEs
!README.md
!data/README.md
!**/README.md

# EDI data package (one-time build/upload, not needed in repo)
data/edi/
manuscript_work/

# Static figures are tracked
!figures_static/*.png
!figures_static/*.tif
!figures_static/*.jpg
!scripts/7_publish/metadata/dictionaries/*.csv
dev/

